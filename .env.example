# ===== Database =====
# Local development (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tennis_online"

# Production (Supabase) — เปลี่ยนค่านี้เพียงค่าเดียวเพื่อย้าย DB
# DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ===== API =====
PORT=3001
# development | production — controls the session cookie's `Secure` flag.
# Must be "production" (served over HTTPS) for cookies to reach the browser.
NODE_ENV=development

# ===== JWT =====
# Generate a real one for prod, e.g.: openssl rand -base64 48
JWT_SECRET=your_super_secret_key_change_this_in_production
# Session cookie itself has no expiry (cleared when the browser closes) —
# this is a backstop cap on how long that cookie stays valid if it survives
# a browser restart (e.g. "continue where you left off").
JWT_EXPIRES_IN=1d

# ===== File Upload =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
